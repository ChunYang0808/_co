// File name: projects/03/b/RAM16K.hdl

/**
 * Memory of 16K registers, each 16 bit-wide.
 * The chip facilitates read/write operations.
 */

CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:

    // address[12..13] 決定要寫入哪一顆 RAM4K
    DMux4Way(
        in=load,
        sel=address[12..13],
        a=load0,
        b=load1,
        c=load2,
        d=load3
    );

    // 四顆 RAM4K = 16K
    RAM4K(
        in=in,
        load=load0,
        address=address[0..11],
        out=out0
    );

    RAM4K(
        in=in,
        load=load1,
        address=address[0..11],
        out=out1
    );

    RAM4K(
        in=in,
        load=load2,
        address=address[0..11],
        out=out2
    );

    RAM4K(
        in=in,
        load=load3,
        address=address[0..11],
        out=out3
    );

    // address[12..13] 決定要讀哪一顆 RAM4K
    Mux4Way16(
        a=out0,
        b=out1,
        c=out2,
        d=out3,
        sel=address[12..13],
        out=out
    );
}